# ============================================
# CONFIGURAÇÃO DA APLICAÇÃO - API RASTREADORES
# ============================================
# Copie este arquivo para .env e preencha os valores

# ===== BANCO DE DADOS =====
# Conexão PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=api_rastreadores
DB_USER=postgres
DB_PASSWORD=sua_senha_aqui

# ===== JWT - TOKENS DE AUTENTICAÇÃO =====
# Secret para assinar Access Token (curta duração)
# Use uma string aleatória e segura (recomendado: 32+ caracteres)
JWT_SECRET=sua_secret_key_access_token_aqui_no_minimo_32_caracteres

# Secret para assinar Refresh Token (longa duração)
# Use uma string aleatória e DIFERENTE da JWT_SECRET
# Use uma string aleatória e segura (recomendado: 32+ caracteres)
REFRESH_JWT_SECRET=sua_secret_key_refresh_token_aqui_no_minimo_32_caracteres

# ===== SERVIDOR =====
# Porta em que a aplicação vai rodar
PORT=3000

# Ambiente (development, production, test)
NODE_ENV=development

# ===== SEGURANÇA =====
# CORS: Origins permitidos para requisições
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# ===== DICAS DE SEGURANÇA =====
# - NUNCA commitar este arquivo no git
# - JWT_SECRET e REFRESH_JWT_SECRET devem ser diferentes
# - Use senhas FORTES para o banco de dados
# - Em produção, use variáveis de ambiente do servidor
# - Mude os secrets regularmente
# - Use HTTPS em produção
